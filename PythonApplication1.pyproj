    <Content Include="templates\report_account.html" />
    <Content Include="templates\report_debtors.html" />
    <Content Include="templates\report_turnover.html" />
    <Content Include="templates\saldo_form.html" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="static\" />
    <Folder Include="templates\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
